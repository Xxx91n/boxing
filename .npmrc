# Project-level npm registry — pinned to official source for reproducible builds.
# 项目级 npm 源 — 固定为官方源，确保构建可复现。
# China developers can temporarily use mirror for faster install:
# 国内开发者可临时使用镜像加速安装：
#   npm install --registry=https://registry.npmmirror.com
registry=https://registry.npmjs.org/
# Minimum release age: refuse installs of packages published less than 7 days ago (spec #75 D4).
# 最低发布年龄：拒绝安装发布不足 7 天的包（spec #75 D4）。
min-release-age=7
# Fail installs whose Node/npm do not satisfy package.json engines before any dependency work (CodeRabbit #94).
engine-strict=true
