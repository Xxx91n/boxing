{
  "manifest_version": 3,
  "name": "Boxing",
  "short_name": "Boxing",
  "description": "A hierarchical, infinite-canvas bookmark organizer with beige minimalist design. Organize bookmarks into labeled boxes with list and grid views.",
  "version": "3.0.0",
  "author": "Boxing Contributors",
  "default_locale": "en",
  "icons": {
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  },
  "action": {
    "default_title": "Boxing",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon_48.png",
      "128": "icons/icon_128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "ntp/index.html"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [],
  "browser_specific_settings": {
    "gecko": {
      "id": "{2F5A8F1E-9B3C-4D7E-A2B1-6F4C8E9D3A7F}",
      "strict_min_version": "109.0"
    }
  }
}
