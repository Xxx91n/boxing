# Normalize all text files to LF in the repository
* text=auto eol=lf

# Windows-native scripts must keep CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary files - no line ending conversion
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.xpi   binary
*.zip   binary
LICENSE text eol=lf
