{
  "name": "boxing",
  "version": "2026.8.21",
  "description": "A hierarchical, infinite-canvas bookmark organizer with beige minimalist design.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node .github/scripts/build.mjs",
    "dev:chrome": "npm run build && web-ext run -t chromium --source-dir=dist/boxing-chrome",
    "dev:firefox": "npm run build && web-ext run --source-dir=dist/boxing-firefox",
    "dev:chrome:no-build": "web-ext run -t chromium --source-dir=dist/boxing-chrome --no-reload",
    "dev:firefox:no-build": "web-ext run --source-dir=dist/boxing-firefox --no-reload",
    "guard:import-graph": "node scripts/import-graph-guard.mjs",
    "pretest": "node scripts/import-graph-guard.mjs",
    "test": "node scripts/test-mutex.mjs full",
    "test:all": "node scripts/test-mutex.mjs full",
    "test:changed": "node scripts/test-mutex.mjs changed",
    "test:chromium": "node scripts/test-mutex.mjs full --project=chromium-extension",
    "test:firefox": "node scripts/test-mutex.mjs full --project=firefox-extension",
    "test:failed": "node scripts/test-mutex.mjs playwright test --config=test/playwright.config.ts --last-failed",
    "test:quarantine": "node scripts/test-mutex.mjs playwright test --config=test/playwright.quarantine.config.ts --grep=@quarantine --pass-with-no-tests",
    "test:debug": "node scripts/test-mutex.mjs full --project=chromium-extension --debug",
    "postinstall": "node -e \"console.warn('[boxing] Playwright browsers not installed. Run: npx playwright install firefox chromium')\""
  },
  "devDependencies": {
    "web-ext": "^8.10.0",
    "@playwright/test": "^1.48.0",
    "crx3": "^1.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Xxx91n/boxing.git"
  },
  "homepage": "https://github.com/Xxx91n/boxing#readme",
  "bugs": {
    "url": "https://github.com/Xxx91n/boxing/issues"
  }
}
