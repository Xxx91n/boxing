{
  "name": "boxing",
  "version": "3.7.0",
  "description": "A hierarchical, infinite-canvas bookmark organizer with beige minimalist design.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node .github/scripts/build.mjs",
    "dev:chrome": "web-ext run -t chromium --source-dir=dist/boxing-chrome",
    "dev:firefox": "web-ext run --source-dir=dist/boxing-firefox",
    "dev:chrome:no-build": "web-ext run -t chromium --source-dir=dist/boxing-chrome --no-reload",
    "dev:firefox:no-build": "web-ext run --source-dir=dist/boxing-firefox --no-reload"
  },
  "devDependencies": {
    "web-ext": "^8.10.0"
  }
}
